# Public application origin. Required in production for trusted return URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase CMS. Use the project URL and modern publishable key (never a secret/service key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Explicit development/test fixture mode. This is always disabled in production code.
KRATOS_FIXTURE_MODE=false

# Intake delivery. Keep disabled until a reviewed destination adapter is configured.
INTAKE_DELIVERY_MODE=configuration_required
INTAKE_DELIVERY_ENDPOINT=

# Stripe. Price IDs remain server-owned and must only be added after catalogue approval.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
TRAINERIZE_API_KEY=
TRAINERIZE_WEBHOOK_SECRET=
TRAINERIZE_HEALTH_URL=
TRAINERIZE_CLIENT_CREATE_URL=
TRAINERIZE_PLAN_ASSIGN_URL=
CALENDLY_ACCESS_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_SCHEDULING_URL=
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_PDF_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_TOOLS_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_CMS_MODEL=anthropic/claude-sonnet-4.6
AI_PDF_PROVIDER=openrouter
SOL_API_BASE_URL=
SOL_API_KEY=
SOL_PDF_MODEL=gpt-5.6-sol
STRIPE_PRICE_TRANSFORMATIE_PACK=

# Optional durable persistence adapter. No repository is connected by default.
DATABASE_URL=

# Optional operational providers. The application must work without them.
EMAIL_PROVIDER_API_KEY=
ANALYTICS_PROVIDER_KEY=
